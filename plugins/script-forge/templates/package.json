{
	"name": "{{name}}",
	"type": "module",
	"private": true,
	"engines": {
		"bun": "{{bunPin}}"
	},
	"scripts": {
		"lint": "eslint --no-error-on-unmatched-pattern --config {{eslintConfigPath}} \"{{scriptsDir}}/**/*.ts\" \"{{localDir}}/tmp/**/*.ts\"",
		"test": "bun test --pass-with-no-tests",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"eslint": "^10.8.1",
		"@typescript-eslint/eslint-plugin": "^8.67.0",
		"@typescript-eslint/parser": "^8.67.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"eslint-plugin-unicorn": "^65.0.1",
		"typescript": "^6.0.3",
		"@types/bun": "^1.3.14"
	}
}
