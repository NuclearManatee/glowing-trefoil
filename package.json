{
	"name": "glowing-trefoil",
	"version": "1.0.0",
	"description": "Personal collection of AI-coding plugins. First plugin: Script Forge.",
	"license": "MIT",
	"author": "NuclearManatee",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NuclearManatee/glowing-trefoil.git"
	},
	"homepage": "https://github.com/NuclearManatee/glowing-trefoil#readme",
	"bugs": {
		"url": "https://github.com/NuclearManatee/glowing-trefoil/issues"
	},
	"keywords": [
		"claude-code",
		"cowork",
		"cursor",
		"opencode",
		"plugin",
		"script-forge",
		"anvil",
		"tooling",
		"node",
		"typescript"
	],
	"type": "module",
	"bin": {
		"glowing-trefoil": "./dist/cli/index.js"
	},
	"files": [
		"dist",
		"plugins/script-forge",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22.18.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"lint": "eslint -c eslint.tooling.js --no-error-on-unmatched-pattern \"plugins/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\"",
		"typecheck": "tsc --noEmit",
		"test": "node --test --test-reporter=spec \"tests/*.test.ts\"",
		"validate": "node scripts/validate.ts",
		"build:commands": "node scripts/buildCommands.ts",
		"build": "node scripts/buildCli.ts",
		"prepack": "npm run build"
	},
	"dependencies": {
		"zod": "^4.6.6"
	},
	"devDependencies": {
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/node": "^22.18.0",
		"@typescript-eslint/eslint-plugin": "^8.67.0",
		"@typescript-eslint/parser": "^8.67.0",
		"eslint": "^10.8.1",
		"eslint-plugin-unicorn": "^65.0.1",
		"typescript": "^6.0.3"
	}
}
