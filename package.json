{
	"name": "glowing-trefoil",
	"version": "1.0.0",
	"description": "Personal collection of AI-coding plugins. First plugin: Script Forge.",
	"license": "MIT",
	"author": "NuclearManatee",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NuclearManatee/glowing-trefoil.git"
	},
	"homepage": "https://github.com/NuclearManatee/glowing-trefoil#readme",
	"bugs": {
		"url": "https://github.com/NuclearManatee/glowing-trefoil/issues"
	},
	"keywords": [
		"claude-code",
		"cowork",
		"cursor",
		"opencode",
		"plugin",
		"script-forge",
		"anvil",
		"tooling",
		"bun",
		"typescript"
	],
	"type": "module",
	"packageManager": "bun@1.3.14",
	"bin": {
		"glowing-trefoil": "./dist/cli.js"
	},
	"files": [
		"dist",
		"plugins/script-forge",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22",
		"bun": "1.3.14"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"lint": "eslint -c eslint.tooling.js --no-error-on-unmatched-pattern \"plugins/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\"",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"validate": "bun run scripts/validate.ts",
		"build:commands": "bun run scripts/buildCommands.ts",
		"build": "bun run scripts/buildCli.ts",
		"prepack": "bun run build"
	},
	"devDependencies": {
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/bun": "^1.3.14",
		"@types/node": "^24.0.0",
		"@typescript-eslint/eslint-plugin": "^8.67.0",
		"@typescript-eslint/parser": "^8.67.0",
		"eslint": "^10.8.1",
		"eslint-plugin-unicorn": "^65.0.1",
		"typescript": "^6.0.3",
		"zod": "^4.4.3"
	}
}
